WEMO_CONFIG_DIR=/etc/wemo-matter-bridge
WEMO_STATE_DIR=/var/lib/wemo-matter-bridge
WEMO_BRIDGE_APP=/usr/sbin/wemo-bridge-app

# Leave empty to use the default-route interface. Set to eth0, wlan0, etc. if
# the bridge should bind to a specific LAN interface.
WEMO_BRIDGE_INTERFACE=

WEMO_BRIDGE_GENERATE_ONBOARDING=1
WEMO_BRIDGE_DEV_FIXED_ONBOARDING=0

WEMO_DEVICE_DB_PATH=/var/lib/wemo-matter-bridge/wemo_device.db
WEMO_STATE_DB_PATH=/var/lib/wemo-matter-bridge/wemo_state.db
WEMO_AUDIT_DB_PATH=/var/lib/wemo-matter-bridge/wemo_txn_audit.db

WEMO_STATE_POLL_INTERVAL_SEC=15
WEMO_DEVICE_SYNC_INTERVAL_SEC=30
WEMO_INITIAL_DISCOVERY_WAIT_SEC=90
WEMO_DISCOVER_INTERVAL_SEC=300
WEMO_DEVICE_GC_AFTER_SEC=86400
