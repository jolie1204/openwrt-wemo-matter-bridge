[Unit]
Description=OpenWeMo LAN controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/wemo-matter-bridge
ExecStartPre=/usr/bin/install -d -m 0700 -o root -g root /var/lib/wemo-matter-bridge
ExecStart=/usr/sbin/wemo_ctrl
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
