#!/bin/sh
set -eu

DEFAULT_ENV=${WEMO_DEFAULT_ENV:-/etc/default/wemo-matter-bridge}
[ -r "$DEFAULT_ENV" ] && . "$DEFAULT_ENV"

CONFIG_DIR=${WEMO_CONFIG_DIR:-/etc/wemo-matter-bridge}
STATE_DIR=${WEMO_STATE_DIR:-/var/lib/wemo-matter-bridge}
CHIP_DIR=$STATE_DIR/chip
ONBOARDING_JSON=$CONFIG_DIR/matter-onboarding.json
BRIDGE_APP=${WEMO_BRIDGE_APP:-/usr/sbin/wemo-bridge-app}
IFACE=${WEMO_BRIDGE_INTERFACE:-}

json_get()
{
	key="$1"
	sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\\{0,1\\}\\([^\",}]*\\)\"\\{0,1\\}.*/\\1/p" "$ONBOARDING_JSON" 2>/dev/null | head -n 1
}

if [ -z "$IFACE" ]; then
	IFACE="$(ip route show default 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1)"
fi
[ -n "$IFACE" ] || IFACE=eth0

mkdir -p "$CHIP_DIR"
chmod 0700 "$STATE_DIR" "$CHIP_DIR" 2>/dev/null || true

/usr/sbin/wemo-matter-bridge onboarding

PASSCODE="$(json_get setup_passcode)"
DISCRIMINATOR="$(json_get discriminator)"
[ -n "$PASSCODE" ] && [ -n "$DISCRIMINATOR" ] || {
	echo "Wemo Matter onboarding data is missing" >&2
	exit 1
}

export WEMO_DEVICE_DB_PATH="${WEMO_DEVICE_DB_PATH:-$STATE_DIR/wemo_device.db}"
export WEMO_STATE_DB_PATH="${WEMO_STATE_DB_PATH:-$STATE_DIR/wemo_state.db}"
export WEMO_AUDIT_DB_PATH="${WEMO_AUDIT_DB_PATH:-$STATE_DIR/wemo_txn_audit.db}"
export WEMO_STATE_POLL_INTERVAL_SEC="${WEMO_STATE_POLL_INTERVAL_SEC:-15}"
export WEMO_DEVICE_SYNC_INTERVAL_SEC="${WEMO_DEVICE_SYNC_INTERVAL_SEC:-30}"
export WEMO_INITIAL_DISCOVERY_WAIT_SEC="${WEMO_INITIAL_DISCOVERY_WAIT_SEC:-90}"

exec "$BRIDGE_APP" \
	--KVS "$CHIP_DIR/chip_kvs" \
	--interface-id "$IFACE" \
	--passcode "$PASSCODE" \
	--discriminator "$DISCRIMINATOR"
