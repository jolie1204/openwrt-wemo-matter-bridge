#!/bin/sh /etc/rc.common
START=17
USE_PROCD=1

NVRAM=/sbin/nvram
MATTERCFG=/etc/config/matter
KVS=/etc/matter/chip_kvs.ini

# ---------- helpers ----------
sanitize_ascii() { tr -cd 'A-Za-z0-9._-'; }
nvram_get() { "$NVRAM" get "$1" 2>/dev/null; }
uci_get()  { uci -q get "$1"; }

# 16-bit -> little-endian hex (from decimal)
le16_from_dec() {
	local v=$(( $1 + 0 ))
	local lo=$(( v & 0xFF ))
	local hi=$(( (v >> 8) & 0xFF ))
	printf "%02x%02x" "$lo" "$hi"
}

# 16-bit -> little-endian hex (from hex string, e.g. "FFF1" or "0xFFF1")
le16_from_hex() {
	local h="${1#0x}"; h="${h#0X}"
	# normalize to 4 hex nibbles
	local x
	x=$(printf "%04x" $((16#$h)))
	# swap bytes
	printf "%s%s" "${x:2:2}" "${x:0:2}"
}

# Pick prefix + PID from SerialNumber
# sets: PREF PID_HEX (hex string, no 0x)
pick_model() {
	local SN="$1"
	case "$SN" in
		*K??1*) PREF="Wemo.Mini.";   PID_HEX="8001" ;; # SwitchV2/Mini
		*K??3*) PREF="Wemo.Light.";  PID_HEX="8002" ;;
		*K??5*) PREF="Wemo.Dimmer."; PID_HEX="8003" ;;
		*)      PREF="Wemo.Mini.";   PID_HEX="8001" ;;
	esac
}

mk_ssid() {
	local SN PREF TAIL
	SN="$(nvram_get SerialNumber | tr -d '\r\n' | sanitize_ascii)"
	[ -n "$SN" ] || SN="WEMO-UNKNOWN"
	pick_model "$SN"
	TAIL="$(echo -n "$SN" | sed -n 's/.*\([0-9][0-9][0-9]\)$/\1/p')"
	[ -n "$TAIL" ] || TAIL="000"
	echo -n "${PREF}${TAIL}"
}

# Build CSA/Matter SoftAP Vendor IE for hostapd vendor_elements:
# dd <len> d2 04 00  01 01 01  02 02 <VID_le>  03 02 <PID_le>  04 02 <DISC_le>  05 01 01
mk_vendor_ie() {
	local PASS DISC SN VID_HEX PID
	local OUI="d20400"    # CSA (00:04:D2)
	PASS="$(uci_get matter.matter.passcode)";      [ -n "$PASS" ] || PASS=20202021
	DISC="$(uci_get matter.matter.discriminator)"; [ -n "$DISC" ] || DISC=3840
	SN="$(nvram_get SerialNumber | tr -d '\r\n' | sanitize_ascii)"
	[ -n "$SN" ] || SN="WEMO-UNKNOWN"
	VID_HEX="$(uci_get matter.matter.vendor_id)";  [ -n "$VID_HEX" ] || VID_HEX="FFF1"
	pick_model "$SN"; PID="$PID_HEX"

	# normalize values
	local pass4=$(( PASS % 10000 ))
	local disc12=$(( DISC & 0x0FFF ))

	# LE encodings
	local VID_LE PID_LE DISC_LE PASS4_LE
	VID_LE="$(le16_from_hex "$VID_HEX")"
	PID_LE="$(le16_from_hex "$PID")"
	DISC_LE="$(le16_from_dec "$disc12")"
	PASS4_LE="$(le16_from_dec "$pass4")"

	# TLVs (type, len, value)
	local TLV_VER="010101"               # Version = 1
	local TLV_VID="0202${VID_LE}"        # Vendor ID (LE)
	local TLV_PID="0302${PID_LE}"        # Product ID (LE)
	local TLV_DSC="0402${DISC_LE}"       # Discriminator (LE)
	local TLV_CM="050101"                # Commissioning Mode = 1

	local BODY="${OUI}${TLV_VER}${TLV_VID}${TLV_PID}${TLV_DSC}${TLV_CM}"
	local LEN=$(printf "%02x" $(( ${#BODY} / 2 )))

	echo "dd${LEN}${BODY}"
}

# Consider device commissioned if KVS contains OpCreds artifacts
is_commissioned() {
	[ -s "$KVS" ] || return 1
	grep -qiE 'Fabric|AddNOC|TrustedRoot|OpCreds|NOC' "$KVS"
}

apply_wireless() {
	[ -f /etc/config/wireless ] || wifi config

	local NEWSSID CURSSID VIE
	NEWSSID="$(mk_ssid)"
	CURSSID="$(uci -q get wireless.ap_setup.ssid || echo)"

	# Ensure onboarding AP stanza exists
	uci -q set wireless.ap_setup='wifi-iface'
	uci -q set wireless.ap_setup.mode='ap'
	uci -q set wireless.ap_setup.device='radio0'
	uci -q set wireless.ap_setup.ifname='ra0'
	uci -q set wireless.ap_setup.network='setup_ap'
	uci -q set wireless.ap_setup.encryption='none'

	# Update SSID if changed
	[ "$CURSSID" = "$NEWSSID" ] || uci -q set wireless.ap_setup.ssid="$NEWSSID"

	# Seed Vendor IE (hostapd vendor_elements)
	VIE="$(mk_vendor_ie)"
	uci -q delete wireless.ap_setup.vendor_elements
	uci -q set wireless.ap_setup.vendor_elements="$VIE"

	# Keep AP enabled during setup
	uci -q set wireless.ap_setup.disabled='0'

	uci -q commit wireless
	wifi reload 2>/dev/null || wifi
	logger -t wemo-ssid "AP SSID='${NEWSSID}', vendor_elements='${VIE}'"
}

maybe_disable_ap() {
	if is_commissioned; then
		uci -q set wireless.ap_setup.disabled='1'
		uci -q commit wireless
		wifi reload 2>/dev/null || wifi
		logger -t wemo-ssid "Commissioned: disabling onboarding AP (ra0)"
	fi
}

# ---------- procd ----------
start_service() {
	# Create default Matter config (if missing)
	if [ ! -f "$MATTERCFG" ]; then
		cat >"$MATTERCFG" <<'EOF'
config matter 'matter'
	option passcode '20202021'
	option discriminator '3840'
	# optional: vendor_id defaults to 'FFF1' if unset
EOF
	fi

	apply_wireless
	maybe_disable_ap

	# Watcher to auto-disable AP after commissioning (exits once done)
	procd_open_instance
	procd_set_param command /bin/sh -c '
		for i in $(seq 1 720); do
			if [ -s "'$KVS'" ] && grep -qiE "Fabric|AddNOC|TrustedRoot|OpCreds|NOC" "'$KVS'"; then
				uci set wireless.ap_setup.disabled=1
				uci commit wireless
				wifi reload 2>/dev/null || wifi
				logger -t wemo-ssid "Watcher: commissioned -> AP off"
				exit 0
			fi
			sleep 5
		done
		exit 0
	'
	procd_set_param respawn 0 0 0
	procd_close_instance
}

reload_service() {
	apply_wireless
	maybe_disable_ap
}

service_triggers() {
	# Rebuild IE/SSID if Matter or Wireless UCI changes
	procd_add_reload_trigger matter wireless
}
