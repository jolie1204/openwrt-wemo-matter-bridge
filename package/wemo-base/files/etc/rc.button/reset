#!/bin/sh

. /lib/functions.sh

OVERLAY="$( grep ' /overlay ' /proc/mounts )"
RELAY_HELPER=/usr/bin/relay
RELAY_SYS=/sys/class/gpio/relay/value  # fallback if helper missing

ensure_relay_sys() {
    [ -e "$RELAY_SYS" ] && return 0
    [ -d /sys/class/gpio/gpio19 ] || echo 19 > /sys/class/gpio/export 2>/dev/null
    echo out > /sys/class/gpio/gpio19/direction 2>/dev/null
    ln -sf /sys/class/gpio/gpio19/value "$RELAY_SYS" 2>/dev/null
}

# tiny wrapper so we always update the LED:
relay_set() {
    if [ -x "$RELAY_HELPER" ]; then
        "$RELAY_HELPER" set "$1"
    else
        ensure_relay_sys
        echo "${1:-0}" > "$RELAY_SYS"
        # no LED sync without helper
    fi
}
relay_toggle() {
    if [ -x "$RELAY_HELPER" ]; then
        "$RELAY_HELPER" toggle
    else
        ensure_relay_sys
        cur=$(cat "$RELAY_SYS" 2>/dev/null)
        [ "$cur" = "0" ] && nxt=1 || nxt=0
        echo "$nxt" > "$RELAY_SYS"
    fi
}

case "$ACTION" in
pressed)
    [ -z "$OVERLAY" ] && return 0
    return 5
    ;;

timeout)
    . /etc/diag.sh 2>/dev/null && set_state failsafe
    ;;

released)
    # Short press: <2s -> toggle relay (also updates LED via helper)
    if [ "$SEEN" -lt 2 ]; then
        relay_toggle

    # Medium: 5–9s -> reboot
    elif [ "$SEEN" -ge 5 ] && [ "$SEEN" -lt 10 ] && [ -n "$OVERLAY" ]; then
        echo "REBOOT" > /dev/console
        sync
        reboot -f

    # Long: >=10s -> factory reset
    elif [ "$SEEN" -ge 10 ] && [ -n "$OVERLAY" ]; then
        echo "FACTORY RESET" > /dev/console
        jffs2reset -y && reboot &
    fi
    ;;
esac

return 0

