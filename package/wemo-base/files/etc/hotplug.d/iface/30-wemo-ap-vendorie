#!/bin/sh
# When setup_ap (ra0) ifup happens, inject Vendor IE and persist it in UCI

[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "setup_ap" ] || exit 0

# Allow overrides via /etc/matter/wemo.env (optional)
[ -r /etc/matter/wemo.env ] && . /etc/matter/wemo.env

OUI=${OUI:-24f5a2}
VID_HEX=${VID_HEX:-FFF1}
PID_HEX=${PID_HEX:-8001}
DISC_HEX=${DISC_HEX:-0F00}
AP_IF=${AP_IF:-ra0}
UCI_IF=${UCI_IF:-ap_setup}

lower() { tr 'A-F' 'a-f'; }

VIE="dd11${OUI}01010102$(echo $VID_HEX | lower)0202$(echo $PID_HEX | lower)0302$(echo $DISC_HEX | lower)"

# Live update via hostapd (no restart)
if command -v hostapd_cli >/dev/null 2>&1; then
  hostapd_cli -i "$AP_IF" set vendor_elements "$VIE" >/dev/null 2>&1
  hostapd_cli -i "$AP_IF" update_beacon >/dev/null 2>&1
fi

# Persist so subsequent boots keep it
uci -q set wireless.$UCI_IF.vendor_elements="$VIE"
uci -q commit wireless

