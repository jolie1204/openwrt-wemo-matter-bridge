config defaults
	option syn_flood '1'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'REJECT'

config zone
	option name 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'REJECT'
	# This ties the zone to your 'lan' interface (which apcli0 belongs to)
	option network 'lan'

config zone
	option name 'setup'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option network 'setup_ap'

config zone
	option name 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	option network 'wan'

# ---- Allow mDNS on LAN (commissionable discovery) ----
# IPv4 mDNS
config rule
	option name 'Allow-mDNS-IPv4-lan'
	option src 'lan'
	option proto 'udp'
	option dest_ip '224.0.0.251'
	option dest_port '5353'
	option target 'ACCEPT'

# IPv6 mDNS
config rule
	option name 'Allow-mDNS-IPv6-lan'
	option family 'ipv6'
	option src 'lan'
	option proto 'udp'
	option dest_ip 'ff02::fb'
	option dest_port '5353'
	option target 'ACCEPT'

# ---- Allow Matter port(s) on LAN ----
# UDP 5540 (commissioning/operational)
config rule
	option name 'Allow-Matter-UDP-5540-lan'
	option src 'lan'
	option proto 'udp'
	option dest_port '5540'
	option target 'ACCEPT'

# TCP 5540 (controllers sometimes use TCP)
config rule
	option name 'Allow-Matter-TCP-5540-lan'
	option src 'lan'
	option proto 'tcp'
	option dest_port '5540'
	option target 'ACCEPT'
