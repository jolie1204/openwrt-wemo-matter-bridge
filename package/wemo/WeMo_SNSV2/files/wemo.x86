#!/bin/sh /etc/rc.common

START=70

start() {
    mkdir -p /tmp/Belkin_settings
    mount -t ext2 /dev/sda3 /tmp/Belkin_settings
    sh /sbin/startWemo.sh &
    udhcpc -i br-lan
}

stop() {
   wemoPid=`ps | awk '/sbin\/startWemo/ {print $1}'`
   kill -9 $wemoPid
   killall wemoApp
   #Magic Close of watchdog after App stops to prevent system reboot due to watchdog.
   echo "V" >/dev/watchdog
}
