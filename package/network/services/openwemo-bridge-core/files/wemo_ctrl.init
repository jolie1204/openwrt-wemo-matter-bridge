#!/bin/sh /etc/rc.common

START=90
USE_PROCD=1

CONF=/etc/wemo_ctrl.conf
STATE_DIR=/data/wemo-matter
AUDIT_DB=/data/wemo-matter/wemo_txn_audit.db
NETWORK=lan
DEFAULT_IFACE=br-lan
WAIT_SECS=90
READY_SETTLE_SECS=2
DEVICE_GC_AFTER_SECS=86400

resolve_ifname()
{
	local ifname

	ifname="$(ubus call "network.interface.$NETWORK" status 2>/dev/null | \
		jsonfilter -q -e '@["l3_device"]')"
	[ -n "$ifname" ] || ifname="$(ubus call "network.interface.$NETWORK" status 2>/dev/null | \
		jsonfilter -q -e '@["device"]')"
	[ -n "$ifname" ] || ifname="$DEFAULT_IFACE"

	echo "$ifname"
}

network_ready()
{
	local ifname

	ifname="$(resolve_ifname)"
	ubus call "network.interface.$NETWORK" status 2>/dev/null | grep -q '"up": true' || return 1
	ip -4 addr show dev "$ifname" 2>/dev/null | grep -q 'inet ' || return 1
}

wait_for_network()
{
	local remaining="$WAIT_SECS"

	while [ "$remaining" -gt 0 ]; do
		network_ready && {
			sleep "$READY_SETTLE_SECS"
			return 0
		}
		sleep 1
		remaining=$((remaining - 1))
	done

	echo "Wemo network interface '$NETWORK' is not ready"
	return 1
}

prepare_state()
{
	/etc/init.d/wemo_mtd_data start || return 1

	mkdir -p "$STATE_DIR"
	chmod 0700 "$STATE_DIR"
}

start_service()
{
	local ifname

	prepare_state || return 1
	wait_for_network || return 1
	ifname="$(resolve_ifname)"

	procd_open_instance
	procd_set_param command /usr/sbin/wemo_ctrl
	procd_set_param env WEMO_AUDIT_DB_PATH="$AUDIT_DB"
	procd_set_param env WEMO_UPNP_IFNAME="$ifname"
	procd_set_param env WEMO_DEVICE_GC_AFTER_SEC="$DEVICE_GC_AFTER_SECS"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3000 5 5
	procd_set_param file "$CONF"
	procd_close_instance
}

reload_service()
{
	stop
	start
}

service_triggers()
{
	procd_add_reload_interface_trigger "$NETWORK"
}
