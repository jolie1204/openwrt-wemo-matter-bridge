#!/bin/sh /etc/rc.common

START=90
USE_PROCD=1

CONF=/etc/wemo_ctrl.conf
STATE_DIR=/etc/wemo-matter

start_service()
{
	mkdir -p "$STATE_DIR"
	chmod 0700 "$STATE_DIR"

	procd_open_instance
	procd_set_param command /usr/sbin/wemo_ctrl
	procd_set_param env WEMO_UPNP_IFNAME=br-lan
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3000 5 5
	procd_set_param file "$CONF"
	procd_close_instance
}

reload_service()
{
	stop
	start
}
