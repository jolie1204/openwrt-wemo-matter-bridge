#!/bin/sh /etc/rc.common

START=90
USE_PROCD=1

CONF=/etc/wemo_ctrl.conf
STATE_DIR=/data/wemo-matter

is_data_mounted()
{
	grep -qs " /data " /proc/mounts
}

prepare_state()
{
	/etc/init.d/wemo_mtd_data start || return 1
	is_data_mounted || {
		echo "Wemo data partition is not mounted"
		return 1
	}

	mkdir -p "$STATE_DIR"
	chmod 0700 "$STATE_DIR"
}

start_service()
{
	prepare_state || return 1

	procd_open_instance
	procd_set_param command /usr/sbin/wemo_ctrl
	procd_set_param env WEMO_UPNP_IFNAME=br-lan
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3000 5 5
	procd_set_param file "$CONF"
	procd_close_instance
}

reload_service()
{
	stop
	start
}
