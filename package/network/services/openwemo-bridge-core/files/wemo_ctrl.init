#!/bin/sh /etc/rc.common

START=90
USE_PROCD=1

CONF=/etc/wemo_ctrl.conf
STATE_DIR=/data/wemo-matter
AUDIT_DB=/data/wemo-matter/wemo_txn_audit.db
IFACE=br-lan
NETWORK=lan
WAIT_SECS=90
READY_SETTLE_SECS=2

is_data_mounted()
{
	grep -qs " /data " /proc/mounts
}

network_ready()
{
	ubus call "network.interface.$NETWORK" status 2>/dev/null | grep -q '"up": true' || return 1
	ip -4 addr show dev "$IFACE" 2>/dev/null | grep -q 'inet ' || return 1
}

wait_for_network()
{
	local remaining="$WAIT_SECS"

	while [ "$remaining" -gt 0 ]; do
		network_ready && {
			sleep "$READY_SETTLE_SECS"
			return 0
		}
		sleep 1
		remaining=$((remaining - 1))
	done

	echo "Wemo network interface '$NETWORK' on '$IFACE' is not ready"
	return 1
}

prepare_state()
{
	/etc/init.d/wemo_mtd_data start || return 1
	is_data_mounted || {
		echo "Wemo data partition is not mounted"
		return 1
	}

	mkdir -p "$STATE_DIR"
	chmod 0700 "$STATE_DIR"
}

start_service()
{
	prepare_state || return 1
	wait_for_network || return 1

	procd_open_instance
	procd_set_param command /usr/sbin/wemo_ctrl
	procd_set_param env WEMO_AUDIT_DB_PATH="$AUDIT_DB"
	procd_set_param env WEMO_UPNP_IFNAME="$IFACE"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3000 5 5
	procd_set_param file "$CONF"
	procd_close_instance
}

reload_service()
{
	stop
	start
}

service_triggers()
{
	procd_add_reload_interface_trigger "$NETWORK"
}
