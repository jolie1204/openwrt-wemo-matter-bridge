+int we_list_devices(struct we_device_list *out)
+{
+    sqlite3 *db = NULL;
+    sqlite3_stmt *stmt = NULL;
+    char state_path[256];
+    char device_path[256];
+    char *attach_sql = NULL;
+    const char *sql =
+        "SELECT d.wemo_id,d.UDN,d.friendly_name,d.device_type,"
+        "COALESCE(s.is_online,0),COALESCE(binary.value,-1),COALESCE(level.value,-1) "
+        "FROM dev.wemo_device d "
+        "LEFT JOIN state s ON s.wemo_id=d.wemo_id "
+        "LEFT JOIN state_capability binary ON binary.wemo_id=d.wemo_id AND binary.cap=1 "
+        "LEFT JOIN state_capability level ON level.wemo_id=d.wemo_id AND level.cap=2 "
+        "ORDER BY d.wemo_id ASC;";
+    int count = 0;
+    int rc;
+
+    if (out == NULL) {
+        return WE_STATUS_INVALID;
+    }
+    memset(out, 0, sizeof(*out));
+
+    we_build_state_db_path(state_path, sizeof(state_path));
+    we_build_device_db_path(device_path, sizeof(device_path));
+    if (state_path[0] == '\0' || device_path[0] == '\0') {
+        return WE_STATUS_INVALID;
+    }
+
+    rc = sqlite3_open_v2(state_path, &db, SQLITE_OPEN_READONLY, NULL);
+    if (rc != SQLITE_OK) {
+        if (db != NULL) {
+            sqlite3_close(db);
+        }
+        return WE_STATUS_INTERNAL;
+    }
+
+    attach_sql = sqlite3_mprintf("ATTACH DATABASE %Q AS dev", device_path);
+    if (attach_sql == NULL) {
+        sqlite3_close(db);
+        return WE_STATUS_INTERNAL;
+    }
+    rc = sqlite3_exec(db, attach_sql, NULL, NULL, NULL);
+    sqlite3_free(attach_sql);
+    if (rc != SQLITE_OK) {
+        sqlite3_close(db);
+        return WE_STATUS_INTERNAL;
+    }
+
+    rc = sqlite3_prepare_v2(db, sql, -1, &stmt, NULL);
+    if (rc != SQLITE_OK) {
+        sqlite3_exec(db, "DETACH DATABASE dev", NULL, NULL, NULL);
+        sqlite3_close(db);
+        return WE_STATUS_INTERNAL;
+    }
+
+    while (count < WE_DEVICE_LIST_MAX_ITEMS && sqlite3_step(stmt) == SQLITE_ROW) {
+        struct we_device_info *info = &out->items[count];
+        memset(info, 0, sizeof(*info));
+        info->wemo_id = sqlite3_column_int(stmt, 0);
+        we_copy_column_text(info->udn, sizeof(info->udn), stmt, 1);
+        we_copy_column_text(info->friendly_name, sizeof(info->friendly_name), stmt, 2);
+        info->device_type = sqlite3_column_int(stmt, 3);
+        info->is_online = sqlite3_column_int(stmt, 4);
+        info->state = sqlite3_column_int(stmt, 5);
+        info->level = sqlite3_column_int(stmt, 6);
+        count++;
+    }
+
+    sqlite3_finalize(stmt);
+    sqlite3_exec(db, "DETACH DATABASE dev", NULL, NULL, NULL);
+    sqlite3_close(db);
+    out->count = count;
+    return WE_STATUS_OK;
+}
