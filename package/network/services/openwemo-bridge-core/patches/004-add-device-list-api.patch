+static void we_build_device_db_path(char *out, size_t out_len)
+{
+    const char *override = getenv("WEMO_DEVICE_DB_PATH");
+    const char *home = getenv("HOME");
+    if (out == NULL || out_len == 0) {
+        return;
+    }
+    out[0] = '\0';
+    if (override != NULL && override[0] != '\0') {
+        snprintf(out, out_len, "%s", override);
+        return;
+    }
+    if (geteuid() == 0) {
+        snprintf(out, out_len, "/var/lib/wemo-matter/wemo_device.db");
+        return;
+    }
+    if (home != NULL && home[0] != '\0') {
+        snprintf(out, out_len, "%s/.local/state/wemo-matter/wemo_device.db", home);
+        return;
+    }
+    snprintf(out, out_len, "/var/tmp/wemo-matter/wemo_device.db");
+}
+
+static void we_copy_column_text(char *out, size_t out_len, sqlite3_stmt *stmt, int column)
+{
+    const unsigned char *text;
+    if (out == NULL || out_len == 0) {
+        return;
+    }
+    text = sqlite3_column_text(stmt, column);
+    snprintf(out, out_len, "%s", text == NULL ? "" : (const char *)text);
+}
