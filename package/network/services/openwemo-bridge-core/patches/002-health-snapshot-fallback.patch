+static void sync_runtime_db_env(void)
+{
+    char audit_db[PATH_MAX];
+    char *slash;
+
+    if (wemo_state_db[0] == '\0') {
+        return;
+    }
+
+    setenv("WEMO_STATE_DB_PATH", wemo_state_db, 1);
+
+    if (snprintf(audit_db, sizeof(audit_db), "%s", wemo_state_db) >= (int)sizeof(audit_db)) {
+        return;
+    }
+
+    slash = strrchr(audit_db, '/');
+    if (slash == NULL) {
+        return;
+    }
+
+    if (snprintf(slash + 1,
+                 sizeof(audit_db) - (size_t)(slash + 1 - audit_db),
+                 "%s",
+                 "wemo_txn_audit.db") >=
+        (int)(sizeof(audit_db) - (size_t)(slash + 1 - audit_db))) {
+        return;
+    }
+
+    setenv("WEMO_AUDIT_DB_PATH", audit_db, 1);
+}
