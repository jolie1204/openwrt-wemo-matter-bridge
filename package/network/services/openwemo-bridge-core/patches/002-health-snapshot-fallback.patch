+static int wemo_ctrl_fill_health_snapshot_from_devices(int wemo_id, int max_items,
+                                                       struct we_health_snapshot *out)
+{
+    struct we_device_list dev_list;
+    int rc;
+    int i;
+    int count = 0;
+
+    if (out == NULL) {
+        return WE_STATUS_INVALID;
+    }
+
+    rc = wemo_ctrl_list_devices(&dev_list);
+    if (rc != WE_STATUS_OK) {
+        return rc;
+    }
+
+    memset(out, 0, sizeof(*out));
+    for (i = 0; i < dev_list.count && count < max_items; i++) {
+        if (wemo_id > 0 && dev_list.items[i].wemo_id != wemo_id) {
+            continue;
+        }
+
+        out->items[count].wemo_id = dev_list.items[i].wemo_id;
+        count++;
+
+        if (wemo_id > 0) {
+            break;
+        }
+    }
+
+    out->count = count;
+    return WE_STATUS_OK;
+}
