+static int wemo_ctrl_fill_health_snapshot_from_devices(int wemo_id, int max_items,
+                                                       struct we_health_snapshot *out)
+{
+    struct wemoDeviceNode *devnode;
+    int id;
+    int i;
+    int count = 0;
+
+    if (out == NULL) {
+        return WE_STATUS_INVALID;
+    }
+
+    memset(out, 0, sizeof(*out));
+    if (max_items <= 0) {
+        max_items = WE_HEALTH_SNAPSHOT_MAX_ITEMS;
+    }
+    if (max_items > WE_HEALTH_SNAPSHOT_MAX_ITEMS) {
+        max_items = WE_HEALTH_SNAPSHOT_MAX_ITEMS;
+    }
+
+    ithread_mutex_lock(&DeviceListMutex);
+    devnode = GlobalDeviceList;
+    for (i = 0; devnode != NULL && count < max_items; i++, devnode = devnode->next) {
+        id = wemo_dev_db_retrieve_id(ctrlpt_dev_db, devnode->device.UDN);
+        if (id <= 0) {
+            continue;
+        }
+        if (wemo_id > 0 && id != wemo_id) {
+            continue;
+        }
+
+        out->items[count].wemo_id = id;
+        count++;
+        if (wemo_id > 0) {
+            break;
+        }
+    }
+    ithread_mutex_unlock(&DeviceListMutex);
+
+    out->count = count;
+    return WE_STATUS_OK;
+}
