#!/bin/sh

DEFAULT_ENV=${WEMO_DEFAULT_ENV:-/etc/default/wemo-matter-bridge}
[ -r "$DEFAULT_ENV" ] && . "$DEFAULT_ENV"

CONFIG_DIR=${WEMO_CONFIG_DIR:-/etc/wemo-matter-bridge}
UCI_CONFIG=wemo-matter-bridge
STATE_DIR=${WEMO_STATE_DIR:-/data/wemo-matter}
CHIP_DIR=$STATE_DIR/chip
ONBOARDING_JSON=$CONFIG_DIR/matter-onboarding.json
FACTORY_INI=$CHIP_DIR/chip_factory.ini
BRIDGE_APP=${WEMO_BRIDGE_APP:-/usr/sbin/wemo-bridge-app}
QR_PNG=/tmp/wemo-matter-bridge-qr.png
WWW_QR_PNG=/www/wemo-matter-bridge-qr.png

DEV_FIXED_PASSCODE=20202021
DEV_FIXED_DISCRIMINATOR=3840

load_config()
{
	local value

	if command -v uci >/dev/null 2>&1; then
		value="$(uci -q get "$UCI_CONFIG.main.generate_onboarding")"
		[ -n "$value" ] && WEMO_BRIDGE_GENERATE_ONBOARDING="${WEMO_BRIDGE_GENERATE_ONBOARDING:-$value}"
		value="$(uci -q get "$UCI_CONFIG.main.dev_fixed_onboarding")"
		[ -n "$value" ] && WEMO_BRIDGE_DEV_FIXED_ONBOARDING="${WEMO_BRIDGE_DEV_FIXED_ONBOARDING:-$value}"
	fi

	WEMO_BRIDGE_GENERATE_ONBOARDING="${WEMO_BRIDGE_GENERATE_ONBOARDING:-1}"
	WEMO_BRIDGE_DEV_FIXED_ONBOARDING="${WEMO_BRIDGE_DEV_FIXED_ONBOARDING:-0}"
}

is_enabled()
{
	case "$1" in
		1|on|ON|true|TRUE|yes|YES) return 0 ;;
	esac
	return 1
}

json_get()
{
	local key="$1"

	if command -v jsonfilter >/dev/null 2>&1; then
		jsonfilter -q -i "$ONBOARDING_JSON" -e "@.$key" 2>/dev/null && return 0
	fi

	sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\\{0,1\\}\\([^\",}]*\\)\"\\{0,1\\}.*/\\1/p" "$ONBOARDING_JSON" 2>/dev/null | head -n 1
}

random_uint32()
{
	hexdump -n 4 -e '1/4 "%u"' /dev/urandom 2>/dev/null
}

valid_passcode()
{
	case "$1" in
		""|*[!0-9]*) return 1 ;;
	esac

	[ "$1" -gt 0 ] 2>/dev/null || return 1
	[ "$1" -le 99999998 ] 2>/dev/null || return 1
	case "$1" in
		11111111|22222222|33333333|44444444|55555555|66666666|77777777|88888888|12345678|87654321|20202021|20202022)
			return 1
			;;
	esac
}

random_passcode()
{
	local pin

	while true; do
		pin="$(( $(random_uint32) % 99999998 + 1 ))"
		valid_passcode "$pin" && {
			printf '%s\n' "$pin"
			return 0
		}
	done
}

random_discriminator()
{
	printf '%s\n' "$(( $(random_uint32) % 4096 ))"
}

payload_field()
{
	local key="$1"

	sed -n "s/^$key=//p" | head -n 1
}

generate_payload()
{
	local passcode="$1"
	local discriminator="$2"

	"$BRIDGE_APP" --wemo-onboarding-payload "$passcode" "$discriminator" 2>/dev/null
}

write_factory_ini()
{
	local passcode="$1"
	local discriminator="$2"

	mkdir -p "$CHIP_DIR"
	chmod 0700 "$STATE_DIR" "$CHIP_DIR" 2>/dev/null || true
	{
		printf '[DEFAULT]\n'
		printf 'discriminator=%s\n' "$discriminator"
		printf 'pin-code=%s\n' "$passcode"
	} > "$FACTORY_INI.tmp" || return 1
	chmod 0600 "$FACTORY_INI.tmp"
	mv "$FACTORY_INI.tmp" "$FACTORY_INI"
}

write_onboarding_json()
{
	local passcode="$1"
	local discriminator="$2"
	local payload="$3"
	local manual="$4"
	local generated_at

	generated_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date)"
	mkdir -p "$CONFIG_DIR"
	chmod 0700 "$CONFIG_DIR" 2>/dev/null || true
	{
		printf '{\n'
		printf '  "setup_passcode": %s,\n' "$passcode"
		printf '  "discriminator": %s,\n' "$discriminator"
		printf '  "qr_payload": "%s",\n' "$payload"
		printf '  "manual_pairing_code": "%s",\n' "$manual"
		printf '  "generated_at": "%s"\n' "$generated_at"
		printf '}\n'
	} > "$ONBOARDING_JSON.tmp" || return 1
	chmod 0600 "$ONBOARDING_JSON.tmp"
	mv "$ONBOARDING_JSON.tmp" "$ONBOARDING_JSON"
}

ensure_onboarding()
{
	local passcode discriminator payload_out qr_payload manual_code

	load_config

	if ! is_enabled "$WEMO_BRIDGE_GENERATE_ONBOARDING"; then
		return 0
	fi

	if [ -s "$ONBOARDING_JSON" ]; then
		passcode="$(json_get setup_passcode)"
		discriminator="$(json_get discriminator)"
		[ -n "$passcode" ] && [ -n "$discriminator" ] && {
			[ -s "$FACTORY_INI" ] || write_factory_ini "$passcode" "$discriminator"
			return 0
		}
	fi

	if is_enabled "$WEMO_BRIDGE_DEV_FIXED_ONBOARDING"; then
		passcode="$DEV_FIXED_PASSCODE"
		discriminator="$DEV_FIXED_DISCRIMINATOR"
	else
		passcode="$(random_passcode)"
		discriminator="$(random_discriminator)"
	fi

	payload_out="$(generate_payload "$passcode" "$discriminator")" || {
		echo "failed to generate Matter onboarding payload" >&2
		return 1
	}
	qr_payload="$(printf '%s\n' "$payload_out" | sed -n 's/^qr_payload=//p' | head -n 1)"
	manual_code="$(printf '%s\n' "$payload_out" | sed -n 's/^manual_pairing_code=//p' | head -n 1)"
	[ -n "$qr_payload" ] && [ -n "$manual_code" ] || {
		echo "Matter onboarding payload generator did not return QR/manual codes" >&2
		return 1
	}

	write_factory_ini "$passcode" "$discriminator" || return 1
	write_onboarding_json "$passcode" "$discriminator" "$qr_payload" "$manual_code"
}

print_qr()
{
	local qr_payload manual_code

	ensure_onboarding || return 1
	qr_payload="$(json_get qr_payload)"
	manual_code="$(json_get manual_pairing_code)"

	printf 'Matter QR payload: %s\n' "$qr_payload"
	printf 'Manual pairing code: %s\n' "$manual_code"
	printf 'Onboarding file: %s\n' "$ONBOARDING_JSON"

	if command -v qrencode >/dev/null 2>&1 && [ -n "$qr_payload" ]; then
		printf '\n'
		qrencode -t ANSIUTF8 "$qr_payload" 2>/dev/null || true
		qrencode -o "$QR_PNG" "$qr_payload" 2>/dev/null && printf '\nPNG: %s\n' "$QR_PNG"
		if [ -d /www ] && [ -w /www ]; then
			qrencode -o "$WWW_QR_PNG" "$qr_payload" 2>/dev/null && printf 'Web PNG: %s\n' "$WWW_QR_PNG"
		fi
	else
		printf 'ASCII QR unavailable: install qrencode or use the QR payload/manual code above.\n'
	fi
}

status_cmd()
{
	printf 'wemo_ctrl: '
	if pidof wemo_ctrl >/dev/null 2>&1; then
		printf 'running\n'
	else
		printf 'stopped\n'
	fi

	printf 'wemo-bridge-app: '
	if pidof wemo-bridge-app >/dev/null 2>&1; then
		printf 'running\n'
	else
		printf 'stopped\n'
	fi

	if [ -s "$ONBOARDING_JSON" ]; then
		printf 'onboarding: configured (%s)\n' "$ONBOARDING_JSON"
	else
		printf 'onboarding: not generated\n'
	fi

	if command -v wemo_client >/dev/null 2>&1; then
		printf 'wemo_client: installed\n'
	fi

	if [ -x /etc/init.d/wemo-matter-bridge-watchdog ]; then
		printf 'watchdog: '
		if pidof wemo-matter-bridge-watchdog >/dev/null 2>&1; then
			printf 'running\n'
		else
			printf 'stopped\n'
		fi
	fi
}

health_cmd()
{
	if command -v wemo-matter-bridge-watchdog >/dev/null 2>&1; then
		wemo-matter-bridge-watchdog once && echo "health: ok"
	else
		echo "wemo-matter-bridge-watchdog is not installed" >&2
		return 1
	fi
}

scan_wemo()
{
	command -v wemo_client >/dev/null 2>&1 || {
		echo "wemo_client is not installed" >&2
		return 1
	}
	printf 'discover\nlistdev\nexit\n' | WEMO_CLIENT_QUIET=1 wemo_client
}

sql_escape()
{
	printf '%s' "$1" | sed "s/'/''/g"
}

sqlite3_busy()
{
	sqlite3 -cmd '.timeout 5000' "$@"
}

insight_ensure_table()
{
	local state_db="$1"

	sqlite3_busy "$state_db" "CREATE TABLE IF NOT EXISTS insight_state (
  wemo_id INTEGER PRIMARY KEY,
  raw_params TEXT NOT NULL,
  binary_state INTEGER,
  last_change INTEGER,
  on_for_sec INTEGER,
  on_today_sec INTEGER,
  on_total_sec INTEGER,
  timespan_sec INTEGER,
  average_power_mw INTEGER,
  current_power_mw INTEGER,
  energy_today_mwh INTEGER,
  energy_total_mwh INTEGER,
  standby_limit_mw INTEGER,
  updated_at INTEGER NOT NULL DEFAULT (strftime('%s','now'))
);"
}

insight_find_port()
{
	local ip="$1"
	local port
	local body

	for port in 49154 49153 49152 49155 49156; do
		body="$(wget -q -T 3 -O - "http://$ip:$port/setup.xml" 2>/dev/null)" || continue
		printf '%s' "$body" | grep -qi '<serviceType>urn:Belkin:service:insight:1</serviceType>' || continue
		printf '%s\n' "$port"
		return 0
	done

	return 1
}

insight_fetch_params()
{
	local ip="$1"
	local port="$2"
	local request="/tmp/wemo-insight-$$.xml"
	local response

	cat > "$request" <<'EOF'
<?xml version="1.0" encoding="utf-8"?>
<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
  <s:Body>
    <u:GetInsightParams xmlns:u="urn:Belkin:service:insight:1" />
  </s:Body>
</s:Envelope>
EOF

	response="$(wget -q -T 5 -O - \
		--header='Content-Type: text/xml; charset="utf-8"' \
		--header='SOAPACTION: "urn:Belkin:service:insight:1#GetInsightParams"' \
		--post-file="$request" \
		"http://$ip:$port/upnp/control/insight1" 2>/dev/null)"
	rm -f "$request"

	printf '%s\n' "$response" | sed -n 's/.*<InsightParams>\([^<]*\)<\/InsightParams>.*/\1/p' | head -n 1
}

insight_store_params()
{
	local state_db="$1"
	local id="$2"
	local params="$3"
	local raw
	local binary_state last_change on_for on_today on_total timespan average_power current_power energy_today energy_total standby_limit

	IFS='|' read -r binary_state last_change on_for on_today on_total timespan average_power current_power energy_today energy_total standby_limit <<EOF
$params
EOF

	raw="$(sql_escape "$params")"
	sqlite3_busy "$state_db" "INSERT INTO insight_state (
  wemo_id, raw_params, binary_state, last_change, on_for_sec, on_today_sec,
  on_total_sec, timespan_sec, average_power_mw, current_power_mw,
  energy_today_mwh, energy_total_mwh, standby_limit_mw, updated_at
) VALUES (
  $id, '$raw', ${binary_state:-0}, ${last_change:-0}, ${on_for:-0}, ${on_today:-0},
  ${on_total:-0}, ${timespan:-0}, ${average_power:-0}, ${current_power:-0},
  ${energy_today:-0}, ${energy_total:-0}, ${standby_limit:-0}, strftime('%s','now')
) ON CONFLICT(wemo_id) DO UPDATE SET
  raw_params = excluded.raw_params,
  binary_state = excluded.binary_state,
  last_change = excluded.last_change,
  on_for_sec = excluded.on_for_sec,
  on_today_sec = excluded.on_today_sec,
  on_total_sec = excluded.on_total_sec,
  timespan_sec = excluded.timespan_sec,
  average_power_mw = excluded.average_power_mw,
  current_power_mw = excluded.current_power_mw,
  energy_today_mwh = excluded.energy_today_mwh,
  energy_total_mwh = excluded.energy_total_mwh,
  standby_limit_mw = excluded.standby_limit_mw,
  updated_at = excluded.updated_at;"
}

insight_refresh_device()
{
	local db="$1"
	local state_db="$2"
	local id="$3"
	local ip
	local port
	local params

	ip="$(sqlite3_busy "$db" "SELECT ipaddr FROM wemo_device WHERE wemo_id = $id AND retired = 0 AND device_type = 5 LIMIT 1;")"
	[ -n "$ip" ] || {
		echo "Insight device not found in DB: $id" >&2
		return 1
	}

	port="$(insight_find_port "$ip")" || {
		echo "Unable to find Insight service for wemo_id=$id ip=$ip" >&2
		return 1
	}

	params="$(insight_fetch_params "$ip" "$port")"
	[ -n "$params" ] || {
		echo "Unable to fetch InsightParams for wemo_id=$id ip=$ip port=$port" >&2
		return 1
	}

	insight_store_params "$state_db" "$id" "$params"
}

insight()
{
	local db="${WEMO_STATE_DIR:-/data/wemo-matter}/wemo_device.db"
	local state_db="${WEMO_STATE_DIR:-/data/wemo-matter}/wemo_state.db"
	local id="${1:-}"
	local ids

	command -v sqlite3 >/dev/null 2>&1 || {
		echo "sqlite3 is not installed" >&2
		return 1
	}

	[ -f "$db" ] || {
		echo "device DB not found: $db" >&2
		return 1
	}
	[ -f "$state_db" ] || {
		echo "state DB not found: $state_db" >&2
		return 1
	}

	insight_ensure_table "$state_db" || return 1

	if [ -n "$id" ]; then
		case "$id" in
			''|*[!0-9]*)
				echo "wemo_id must be numeric" >&2
				return 1
				;;
		esac
		ids="$id"
	else
		ids="$(sqlite3_busy "$db" "SELECT wemo_id FROM wemo_device WHERE retired = 0 AND device_type = 5 ORDER BY friendly_name;")"
	fi

	if [ -z "$ids" ]; then
		echo "No active WeMo Insight devices found."
		return 0
	fi

	for id in $ids; do
		insight_refresh_device "$db" "$state_db" "$id" || true
	done

	sqlite3_busy -header -column "$state_db" "ATTACH '$db' AS dev;
SELECT
  d.wemo_id,
  d.friendly_name,
  d.model_name,
  s.binary_state,
  ROUND(COALESCE(s.current_power_mw, 0) / 1000.0, 3) AS current_w,
  ROUND(COALESCE(s.average_power_mw, 0) / 1000.0, 3) AS average_w,
  s.on_for_sec,
  s.on_today_sec,
  ROUND(COALESCE(s.energy_today_mwh, 0) / 60000.0, 3) AS today_wh,
  ROUND(COALESCE(s.energy_total_mwh, 0) / 60000.0, 3) AS total_14d_wh,
  datetime(s.updated_at, 'unixepoch', 'localtime') AS updated
FROM insight_state s
JOIN dev.wemo_device d ON d.wemo_id = s.wemo_id
WHERE d.retired = 0
  AND d.device_type = 5
  AND ('$1' = '' OR d.wemo_id = CAST('$1' AS INTEGER))
ORDER BY d.friendly_name;"
}

reset_onboarding()
{
	if [ "$1" != "--force" ] && [ "$1" != "-f" ]; then
		echo "This resets local onboarding credentials."
		echo "Already-commissioned Apple Home / Google Home controllers may need the bridge removed and added again."
		printf 'Continue? [y/N] '
		read answer
		case "$answer" in
			y|Y|yes|YES) ;;
			*) echo "cancelled"; return 1 ;;
		esac
	fi

	rm -f "$ONBOARDING_JSON" "$FACTORY_INI" "$QR_PNG" "$WWW_QR_PNG"
	ensure_onboarding
	print_qr
}

usage()
{
	cat <<'EOF'
Usage: wemo-matter-bridge <command>

Commands:
  onboarding          Generate onboarding data if missing and print JSON path
  qr                  Print QR payload, manual code, and ASCII QR when qrencode is installed
  reset-onboarding    Regenerate onboarding data; controllers may need recommissioning
  status              Show bridge process and onboarding status
  health              Run one watchdog health check
  logs                Follow relevant OpenWrt/systemd logs
  scan-wemo           Trigger WeMo discovery and list devices through wemo_client
  insight [wemo_id]   Refresh and print WeMo Insight power telemetry
  restart             Restart wemo_ctrl and wemo-matter-bridge services
EOF
}

case "$1" in
	onboarding)
		ensure_onboarding || exit 1
		printf 'Onboarding file: %s\n' "$ONBOARDING_JSON"
		;;
	qr)
		print_qr
		;;
	reset-onboarding)
		shift
		reset_onboarding "$@"
		;;
	status)
		status_cmd
		;;
	health)
		health_cmd
		;;
	logs)
		if command -v logread >/dev/null 2>&1; then
			logread -f -e wemo -e matter -e CHIP
		else
			journalctl -u wemo_ctrl -u wemo-matter-bridge -f
		fi
		;;
	scan-wemo)
		scan_wemo
		;;
	insight)
		insight "${2:-}"
		;;
	restart)
		if [ -x /etc/init.d/wemo_ctrl ] && [ -x /etc/init.d/wemo-matter-bridge ]; then
			[ -x /etc/init.d/wemo-matter-bridge-watchdog ] && /etc/init.d/wemo-matter-bridge-watchdog stop
			/etc/init.d/wemo_ctrl restart
			/etc/init.d/wemo-matter-bridge restart
			[ -x /etc/init.d/wemo-matter-bridge-watchdog ] && /etc/init.d/wemo-matter-bridge-watchdog start
		else
			systemctl restart wemo_ctrl wemo-matter-bridge
		fi
		;;
	help|-h|--help|"")
		usage
		;;
	*)
		usage >&2
		exit 1
		;;
esac
