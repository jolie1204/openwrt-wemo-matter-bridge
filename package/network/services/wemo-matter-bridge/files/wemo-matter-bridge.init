#!/bin/sh /etc/rc.common

START=98
USE_PROCD=1

STATE_DIR=/data/wemo-matter
CHIP_DIR=/data/wemo-matter/chip
IFACE=br-lan
NETWORK=lan
WAIT_SECS=90
READY_SETTLE_SECS=2

is_data_mounted()
{
	grep -qs " /data " /proc/mounts
}

network_ready()
{
	ubus call "network.interface.$NETWORK" status 2>/dev/null | grep -q '"up": true' || return 1
	ip -4 addr show dev "$IFACE" 2>/dev/null | grep -q 'inet ' || return 1
}

wait_for_network()
{
	local remaining="$WAIT_SECS"

	while [ "$remaining" -gt 0 ]; do
		network_ready && {
			sleep "$READY_SETTLE_SECS"
			return 0
		}
		sleep 1
		remaining=$((remaining - 1))
	done

	echo "Wemo network interface '$NETWORK' on '$IFACE' is not ready"
	return 1
}

prepare_state()
{
	/etc/init.d/wemo_mtd_data start || return 1
	is_data_mounted || {
		echo "Wemo data partition is not mounted"
		return 1
	}

	CHIP_DIR="$STATE_DIR/chip"
	mkdir -p "$CHIP_DIR"
	chmod 0700 "$STATE_DIR" "$CHIP_DIR"

	touch "$CHIP_DIR/chip_factory.ini"
	touch "$CHIP_DIR/chip_config.ini"
	touch "$CHIP_DIR/chip_counters.ini"

	ln -sf "$CHIP_DIR/chip_factory.ini" /tmp/chip_factory.ini
	ln -sf "$CHIP_DIR/chip_config.ini" /tmp/chip_config.ini
	ln -sf "$CHIP_DIR/chip_counters.ini" /tmp/chip_counters.ini
}

start_service()
{
	prepare_state || return 1
	wait_for_network || return 1

	procd_open_instance
	procd_set_param command /usr/sbin/wemo-bridge-app \
		--KVS "$CHIP_DIR/chip_kvs" \
		--interface-id "$IFACE"
	procd_set_param env WEMO_DEVICE_DB_PATH="$STATE_DIR/wemo_device.db"
	procd_set_param env WEMO_STATE_DB_PATH="$STATE_DIR/wemo_state.db"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3000 5 5
	procd_close_instance
}

reload_service()
{
	stop
	start
}

service_triggers()
{
	procd_add_reload_interface_trigger "$NETWORK"
}
